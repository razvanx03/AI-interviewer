# ==============================================================================
# AI Job Interviewer - Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your custom values.
# ==============================================================================

# Environment Mode ('development' | 'production')
ENVIRONMENT=development

# PostgreSQL Database Credentials (Mandatory)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_interviewer

# Database URL for Backend Service
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_interviewer

# Ollama LLM Configuration (Mandatory)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=your-llm-model-name
DEFAULT_EMBEDDING_MODEL=your-embedding-model-name

# Frontend API URL
VITE_API_URL=http://localhost:8000/api/v1
