# ==============================================================================
# AI Job Interviewer - Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your custom values.
# ==============================================================================

# Environment Mode ('development' | 'production')
ENVIRONMENT=development

# PostgreSQL Database Credentials (Mandatory)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_interviewer

# Database URL for Backend Service
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_interviewer

# Ollama LLM Configuration (Mandatory)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=hf.co/radi04/qwen3-8b-cs-interviewer-merge-v1-150-q4:Q4_K_M
DEFAULT_EMBEDDING_MODEL=nomic-embed-text
LLM_PROVIDER=ollama
SAFETY_MAX_QUESTIONS=15

# Frontend API URL (Use /api/v1 for relative proxy routing or an absolute backend URL)
VITE_API_URL=/api/v1

# Authentication & JWT (Mandatory - generate a secure random 32+ char key)
JWT_SECRET_KEY=change_this_to_a_secure_random_32_char_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Initial Admin Recruiter Seed (Required at runtime; also used during migration when present)
ADMIN_EMAIL=admin@ai-interviewer.com
ADMIN_PASSWORD=change_this_to_a_strong_password

# CORS Allowed Origins (Comma-separated list or JSON array for production domain whitelist)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
CORS_ORIGIN_REGEX=^https://.*\.ngrok(-free)?\.(app|dev)$

