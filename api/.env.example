# Environment Mode ('development' | 'production')
ENVIRONMENT=development

# Database Connection (PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:your_password_here@localhost:5432/ai_interviewer

# Ollama LLM Configuration (Placeholders - to be configured per deployment)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=your-llm-model-name
DEFAULT_EMBEDDING_MODEL=your-embedding-model-name
